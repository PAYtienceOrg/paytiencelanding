# Copy this file to .env.local and fill in the values from Supabase → Project Settings → API Keys.

SUPABASE_URL=

# Accounts (sign up / log in). The publishable key ("sb_publishable_…" or the legacy "anon" key).
# Without it, the sign-up and log-in pages say accounts aren't available yet.
SUPABASE_PUBLISHABLE_KEY=

# Waitlist storage. Server-only secret ("sb_secret_…" or the legacy "service_role" key).
# Never use a NEXT_PUBLIC_ variable for this key.
# Development without it: a process-local memory store is used (data resets on restart).
# Production without it: joining is refused with 503 so no signup is silently lost.
# Initialize the database with docs/waitlist.sql before enabling it.
SUPABASE_SERVICE_ROLE_KEY=

# Public address of the site, used in email links and invite links (e.g. https://paytience.com).
# Optional locally; recommended in production.
SITE_URL=
