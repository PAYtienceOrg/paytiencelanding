# Copy this file to .env.local and fill in the values from MongoDB Atlas → Database → Connect → Drivers.
# Both are only used on the server, for waitlist storage.

# Server-only secret: the connection string contains the database user's password.
# Example: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# Never use a NEXT_PUBLIC_ variable for this value.
# Development without it: a process-local memory store is used (data resets on restart).
# Production without it: joining is refused with 503 so no signup is silently lost.
MONGODB_URI=

# Optional database name (default: paytience). Collections and indexes are created automatically.
MONGODB_DB=
